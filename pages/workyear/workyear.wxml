<view class="page {{fontClass}}">
  <view class="card">
    <text class="section-title">工作年设置</text>
    <text class="text-xs c-gray">每年开工时填开工日期，放假时填收工日期；没填收工日期就统计到当天。</text>

    <view wx:for="{{list}}" wx:key="year" class="year-row">
      <text class="year">{{item.year}} 年</text>
      <picker mode="date" value="{{item.start}}" bindchange="onStart" data-index="{{index}}">
        <view class="date-box {{item.start ? '' : 'empty'}}">{{item.start || '开工日期'}}</view>
      </picker>
      <text class="to">至</text>
      <picker mode="date" value="{{item.end}}" bindchange="onEnd" data-index="{{index}}">
        <view class="date-box {{item.end ? '' : 'empty'}}">{{item.end || '至今'}}</view>
      </picker>
      <text wx:if="{{item.end}}" class="clear" bindtap="clearEnd" data-index="{{index}}">×</text>
    </view>
  </view>
</view>
