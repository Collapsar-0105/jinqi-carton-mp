.page {
  padding-bottom: 24px;
}
.section-title {
  font-weight: bold;
  font-size: 15px;
  display: block;
  margin-bottom: 6px;
}
.counts {
  display: flex;
  gap: 8px;
  margin: 8px 0 10px;
}
.cnt {
  flex: 1;
  text-align: center;
  background: #fafafa;
  border-radius: 8px;
  padding: 10px 0;
}
.cnt-num {
  display: block;
  font-size: 18px;
  font-weight: bold;
  color: #e94560;
}
.cnt-label {
  display: block;
  font-size: 14px;
  color: #999;
  margin-top: 2px;
}
.btn-block { width: 100%; }
.mt-12 { margin-top: 12px; }
.mt-8 { margin-top: 8px; }
.tips .tip {
  display: block;
  font-size: 14px;
  color: #888;
  line-height: 1.7;
}

.font-row { display: flex; gap: 8px; margin-top: 10px; }
.font-opt { flex: 1; text-align: center; padding: 10px 0; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; }
.font-opt.on { border-color: #e94560; color: #e94560; font-weight: bold; background: #fff5f7; }

.cloud-state { display: inline-block; font-size: 15px; font-weight: 700; padding: 2px 10px; border-radius: 10px; background: #eef2f7; color: #555; margin: 6px 0; }
.cloud-state.ok { background: #eaf7ee; color: #2e7d32; }

.danger-btn { color: #e94560; border-color: #f3b6c1; }
.err-text { display: block; margin-top: 8px; font-size: 14px; color: #e94560; }

.page { padding-bottom: 118px; }

.sync-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; }
.sync-label { font-size: 15px; color: #333; }
.sync-value { font-size: 14px; color: #666; }

/* ===== 工作年设置（从原 workyear 页搬来） ===== */
.year-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 0;
  border-bottom: 1px solid #f5f5f5;
}
.year {
  width: 64px;
  font-size: 14px;
  color: #333;
  font-weight: bold;
}
.date-box {
  font-size: 14px;
  padding: 5px 8px;
  border: 1px solid #e5e5e5;
  border-radius: 6px;
  background: #fafafa;
  color: #333;
}
.date-box.empty {
  color: #bbb;
}
.to {
  font-size: 14px;
  color: #999;
}
.clear {
  color: #e94560;
  font-size: 15px;
  padding: 0 4px;
}

/* 原生 button 默认样式要清掉，才能和 .btn 看起来一致 */
.privacy-btn {
  margin: 0;
  padding: 5px 10px;
  font-size: 12px;
  line-height: 1.4;
  font-weight: 600;
}
.privacy-btn::after {
  border: none;
}
