<view class="page {{fontClass}}">
  <view class="card">
    <text class="section-title">填写你的微信昵称</text>
    <text class="text-xs c-gray">微信会把你微信里的昵称带出来，点一下即可。管理员在「用户管理」里靠它认出这台设备是谁。</text>

    <view class="id-row">
      <button class="id-avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{avatar}}" class="id-avatar" src="{{avatar}}" mode="aspectFill" />
        <text wx:else class="id-avatar-ph">头像</text>
      </button>
      <input class="input flex-1 id-input" type="nickname" focus
             placeholder="点这里使用微信昵称" value="{{nickname}}" bindchange="onNickname" />
    </view>

    <view class="id-skip" bindtap="skip">暂不填写，直接进入</view>
  </view>
</view>
