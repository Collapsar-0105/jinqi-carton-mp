<view class="page {{fontClass}}">
  <view class="mask">
    <view class="card id-card">
      <text class="id-title">获取你的头像和昵称</text>
      <text class="text-xs c-gray">管理员在「用户管理」里靠它认出这台设备是谁。昵称可以不填，确认一下就能进。</text>

      <view class="id-row">
        <button class="id-avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image wx:if="{{avatar}}" class="id-avatar" src="{{avatar}}" mode="aspectFill" />
          <text wx:else class="id-avatar-ph">头像</text>
        </button>
        <input class="input flex-1 id-input" type="nickname" focus="{{autoFocus}}"
               placeholder="点这里使用微信昵称" value="{{nickname}}"
               bindchange="onChange" bindblur="onBlur" />
      </view>

      <view class="btn btn-primary btn-block mt-8" bindtap="confirm">确认并进入</view>

      <view wx:if="{{needPrivacy}}" class="id-privacy">
        <text class="text-xs c-gray">需要先同意隐私保护指引，微信才会把头像昵称带出来</text>
        <view class="flex-row gap-8 mt-8">
          <button class="btn btn-sm btn-primary privacy-btn flex-1" id="agree-privacy-btn"
                  open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgree">同意</button>
          <view class="btn btn-sm btn-outline flex-1" bindtap="openPrivacy">查看协议</view>
        </view>
      </view>
    </view>
  </view>
</view>
