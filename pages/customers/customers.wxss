.page {
  padding-bottom: 20px;
}
.section-title {
  font-weight: bold;
  font-size: 15px;
}
.row {
  display: flex;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f5f5f5;
}
.row:last-child {
  border-bottom: none;
}
.row-name {
  font-size: 14px;
  color: #333;
  font-weight: bold;
}
.row-contact {
  font-size: 14px;
  color: #666;
  margin-left: 8px;
}
.row-sub {
  font-size: 14px;
  color: #999;
  margin-top: 3px;
}
.edit {
  color: #3498db;
  font-size: 14px;
  padding-left: 10px;
}
.del {
  color: #e94560;
  font-size: 14px;
  padding-left: 10px;
}

.undo-bar { margin: 8px 10px 0; padding: 8px 12px; background: #fff7e6; border: 1px solid #ffd591; color: #b26a00; border-radius: 10px; font-size: 14px; font-weight: 700; text-align: center; }
