}

/* 状态底色：暂缓黄、超期浅红、已完成绿 */
.order.paused { background: #eff2f6; border-left: 3px solid #6b7688; }
.order.overdue { background: #fdecec; border-left: 3px solid #dc2626; }
.order.done { background: #eefaf1; border-left: 3px solid #2ecc71; }
.order.stocked { border-left: 3px solid #2aa8bd; }
.order.rd-1 { border-left: 3px solid #c0392b; }
.order.rd-3 { border-left: 3px solid #e74c3c; }
.order.rd-5 { border-left: 3px solid #f39c12; }
.order.rd-7 { border-left: 3px solid #f1c40f; }
.multi {
  font-size: 14px;
  color: #fff;
  background: #e94560;
  border-radius: 3px;
  padding: 1px 4px;
  margin-left: 6px;
}
.tag-stock { background: #dbeafe; color: #2563eb; }

/* 剩余工期由浅到深的底色 */
.order-card.rd-7, .order.rd-7 { background: #fffdf2; }
.order-card.rd-5, .order.rd-5 { background: #fff7e6; }
.order-card.rd-3, .order.rd-3 { background: #fff0e0; }
.order-card.rd-1, .order.rd-1 { background: #ffe8dd; }

/* 新版订单卡 */
.order .row1 {
  display: flex;
  align-items: baseline;
  margin-bottom: 8px;
}
.cust {
  font-size: 15px;
  font-weight: bold;
  color: #222;
  margin-right: 8px;
}
.odate {
  font-size: 14px;
  color: #999;
  margin-right: 8px;
}
.ono {
  font-size: 14px;
  color: #2b5bb3;
  background: #eef4ff;
  border-radius: 3px;
  padding: 1px 5px;
  margin-right: 6px;
}
.subtag {
  font-size: 14px;
  color: #fff;
  background: #3498db;
  border-radius: 3px;
  padding: 1px 5px;
}
.remain {
  font-size: 18px;
  font-weight: bold;
  color: #e74c3c;
