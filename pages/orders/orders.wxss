  color: #999;
}
.model {
  font-size: 14px;
  color: #e94560;
  font-weight: bold;
}
.pname {
  font-size: 15px;
  font-weight: bold;
  color: #222;
  display: block;
  margin-top: 2px;
}
.line2 {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-top: 8px;
}
.qty {
  font-size: 18px;
  font-weight: bold;
}
.unit {
  font-size: 14px;
  color: #999;
  margin-left: -6px;
}
.date {
  font-size: 14px;
  font-weight: bold;
  color: #333;
}
.amount {
  margin-left: auto;
  font-size: 14px;
  font-weight: bold;
  color: #e94560;
}
