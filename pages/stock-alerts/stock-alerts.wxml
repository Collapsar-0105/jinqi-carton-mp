<view class="page {{fontClass}}">
  <view class="card">
    <text class="section-title">常备预警（{{list.length}}）</text>
    <text class="text-xs c-gray">常备款现有库存降到 300 个以下时自动生成预警，补货后可手动取消；新建含该常备款的订单时也会提示取消。</text>
  </view>

  <block wx:for="{{list}}" wx:key="id">
    <view class="card alert-card">
      <view class="flex-row a-head">
        <view class="flex-1 a-title">
          <text class="a-id">{{item.productId}}</text>
          <text class="a-name">{{item.productName}}</text>
        </view>
        <view class="a-del" bindtap="remove" data-id="{{item.id}}">取消预警</view>
      </view>

      <view class="a-row a-line">
        <text class="a-k">预警数量</text>
        <text class="a-v">{{item.qty}} 个</text>
        <text class="a-k a-k2">现有库存</text>
        <text class="a-stock">{{item.stockQty}} 个</text>
      </view>

      <view class="a-foot-row">
        <view class="a-foot" bindtap="goOrder" data-order="{{item.orderId}}">来源订单：{{item.orderId}} · {{item._date}}</view>
        <view class="btn btn-sm btn-outline" bindtap="copyInfo" data-id="{{item.productId}}">复制产品信息</view>
      </view>
    </view>
  </block>

  <view wx:if="{{list.length === 0}}" class="empty-state">
    <text class="c-gray">暂无预警</text>
  </view>
</view>
