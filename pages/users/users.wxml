<view class="page {{fontClass}}">
  <view class="card">
    <view class="head-row">
      <text class="section-title">用户管理</text>
      <text class="refresh danger" bindtap="removeAll">清空其它设备</text>
      <text class="refresh" bindtap="load">刷新</text>
    </view>
    <text class="text-xs c-gray">新设备扫码后会自动出现在这里，点「允许」才能同步数据。</text>
    <text wx:if="{{error}}" class="err">{{error}}</text>
  </view>

  <view wx:if="{{loading}}" class="card empty">
    <text class="text-sm">加载中…</text>
  </view>

  <block wx:for="{{list}}" wx:key="openid">
    <view class="card user-card">
      <view class="flex-row">
        <image wx:if="{{item.avatar}}" class="user-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <text class="user-name {{item.name ? '' : 'noname'}}">{{item.name || '未命名设备'}}</text>
        <text class="badge {{item.allowed ? 'ok' : 'wait'}}">{{item.allowed ? '已允许' : '待授权'}}</text>
        <text wx:if="{{item.admin}}" class="badge admin">管理员</text>
        <text wx:else class="badge wait">车间工人</text>
      </view>
      <view class="meta">
        <text wx:if="{{item.device}}">{{item.device}}</text>
      </view>
      <view wx:if="{{!item.name}}" class="hint-line">这台设备还没有名字 → 直接点下面「改名」给他起个名</view>
      <view class="oid-row" bindtap="copyId" data-openid="{{item.openid}}">
        <text class="oid-text">{{item.shortId}}</text>
        <text class="copy">复制</text>
      </view>
      <view class="meta">首次：{{item.createdAt}}</view>
      <view class="meta">最近：{{item.lastSeen}}</view>

      <view class="actions">
        <view class="btn btn-sm btn-outline" bindtap="rename"
              data-openid="{{item.openid}}" data-name="{{item.name}}" data-allowed="{{item.allowed}}">改名</view>
        <view class="btn btn-sm {{item.allowed ? 'btn-outline' : 'btn-primary'}}"
              bindtap="toggle" data-openid="{{item.openid}}" data-allowed="{{item.allowed}}">
          {{item.allowed ? '禁止访问' : '允许访问'}}
        </view>

        <view wx:if="{{!item.admin}}" class="btn btn-sm btn-outline"
              bindtap="setRole" data-openid="{{item.openid}}" data-role="admin">设为管理员</view>
        <view wx:if="{{item.admin && !item.self}}" class="btn btn-sm btn-outline"
              bindtap="setRole" data-openid="{{item.openid}}" data-role="worker">设为工人</view>
        <view wx:if="{{!item.self}}" class="btn btn-sm btn-outline danger"
              bindtap="remove" data-openid="{{item.openid}}">移除</view>
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && list.length === 0}}" class="card empty">
    <text class="text-sm">还没有设备访问过</text>
  </view>
</view>
