.page {
  padding-bottom: 20px;
}

.search-bar {
  padding: 10px 14px 0;
}
.search-input {
  width: 100%;
  box-sizing: border-box;
}

.actions {
  display: flex;
  gap: 8px;
  padding: 10px 14px 0;
  flex-wrap: wrap;
}

.count {
  padding: 10px 16px 0;
  font-size: 14px;
  color: #999;
}

.filters {
  display: flex;
  gap: 8px;
  padding: 10px 14px 0;
  flex-wrap: wrap;
}
.filter-chip {
  display: flex;
  align-items: center;
  padding: 5px 10px;
  background: #fff;
  border: 1px solid #eee;
  border-radius: 14px;
  font-size: 14px;
  color: #555;
}

.group-title {
  padding: 14px 16px 2px;
  font-size: 14px;
  color: #999;
  font-weight: bold;
}

.product-card {
  padding: 12px 14px;
}
.product-card:active {
  background: #fafafa;
}
.p-id {
  font-size: 14px;
  color: #e94560;
  font-weight: bold;
  margin-right: 8px;
}
.p-name {
  font-size: 14px;
  color: #333;
}
.p-price {
  font-size: 14px;
  color: #666;
  margin-left: 8px;
}
.p-spec {
  margin-top: 6px;
  font-size: 14px;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 20px;
}

.file-tag { font-size: 14px; color: #2b5bb3; background: #eef4ff; border-radius: 3px; padding: 1px 4px; margin-right: 4px; }


/* 自定义 tabBar 留白 */
.page { padding-bottom: 118px; }

/* 分组展开收起 */
.expand-bar { display: flex; gap: 14px; padding: 4px 16px 6px; }
.expand-btn { font-size: 14px; color: #2b5bb3; font-weight: 600; }
.group-title { display: flex; align-items: center; gap: 6px; }
.group-arrow { font-size: 14px; color: #666; }
.group-name { font-weight: 700; }
.group-count { margin-left: auto; font-size: 14px; color: #666; }

.cust-line { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 4px; }
.outsource-tag { flex: 0 0 auto; font-size: 14px; font-weight: 700; color: #e94560; background: #fff0f3; border-radius: 8px; padding: 2px 8px; }

.undo-bar { margin: 8px 10px 0; padding: 8px 12px; background: #fff7e6; border: 1px solid #ffd591; color: #b26a00; border-radius: 10px; font-size: 14px; font-weight: 700; text-align: center; }
