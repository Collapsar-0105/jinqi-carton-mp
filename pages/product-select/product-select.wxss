.page {
  padding-bottom: 20px;
}

.search-bar {
  padding: 10px 14px 0;
}
.search-input {
  width: 100%;
  box-sizing: border-box;
}

.item {
  padding: 12px 14px;
}
.item:active {
  background: #fafafa;
}
.p-id {
  font-size: 14px;
  color: #e94560;
  font-weight: bold;
  margin-right: 8px;
}
.p-name {
  font-size: 14px;
  color: #333;
}
.p-price {
  font-size: 14px;
  color: #666;
  margin-left: 8px;
}
.p-spec {
  margin-top: 6px;
  font-size: 14px;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 20px;
}


/* ===== 产品卡：外框 + 上部分层（1.9.76） =====
   配色直接取「加急订单卡」实际在用的颜色（实测像素值）：
     外框 #E8445F / 上半部 #FFE3E8 / 隔断 #E6BCC3 / 主体 #F7F8FA
   注：加急卡的上半部被 orders.wxss 里 `.order.is-urgent .band-head { background:#ffe3e8 !important }`
   覆盖成固定值，所以产品卡这里也用 #FFE3E8，两边才能真正一致。 */
.card.item {
  padding: 12px 14px;
  border-radius: 26px;                                /* 与订单卡一致 */
  border: 0;
  background: #f7f8fa;
  box-shadow: 0 0 0 3px #e8445f, 0 2px 8px rgba(0, 0, 0, 0.07) !important;
  overflow: hidden;
}
.card.item > .flex-row:first-child {
  background: #ffe3e8;
  border-bottom: 3px solid #e6bcc3;   /* = 加急卡 --age-mid 的原色 */
  margin: -12px -14px 8px;
  padding: 12px 14px;
}

/* 系列分组 */
.series-title {
  display: flex; align-items: center; gap: 6px;
  padding: 10px 16px 4px;
  font-size: 13px; color: #666; font-weight: 600;
}
.series-arrow { font-size: 12px; color: #999; }
.series-name { flex: 1; color: #3a3a3c; font-weight: 700; }
.series-count { font-size: 12px; color: #8e8e93; }

/* 品牌层 */
.brand-title {
  display: flex; align-items: center; gap: 8px;
  margin: 8px 14px 2px;
  padding: 10px 12px;
  background: #ffffff;
  border-left: 3px solid #e94560;
  border-radius: 10px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  font-size: 13px; color: #1c1c1e; font-weight: 700;
}
.brand-title:active { background: #f2f2f7; }
.brand-arrow { font-size: 11px; color: #8e8e93; }
.brand-name { flex: 1; }
.brand-count { font-size: 12px; color: #8e8e93; font-weight: 600; }
