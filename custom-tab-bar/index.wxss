.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  background: #fff;
  border-top: 0.5px solid #e5e5ea;
  padding: 12px 0 calc(14px + env(safe-area-inset-bottom));
  box-shadow: none;
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: #8e8e93;
  padding: 3px 0;
}
.tab.on {
  color: #e94560;
  font-weight: 700;
}
