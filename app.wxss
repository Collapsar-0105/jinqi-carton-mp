page {
  background: #f0f2f5;
  font-size: 16px;
  color: #0f0f0f;
  font-weight: 600;
  overflow-x: hidden;
}

/* 对比度与字重：整体更清楚 */
page .label { color: #333; font-weight: 600; }
page .c-gray { color: #444; }
.btn { font-weight: 600; }
page .input { color: #1f1f1f; font-weight: 500; }
page .it-spec, page .text-xs { color: #555; }
page .step-status { color: #444; }

.c-red    { color: #e94560; }
.c-green  { color: #2ecc71; }
.c-blue   { color: #3498db; }
.c-orange { color: #f39c12; }
.c-gray   { color: #999; }
.bg-red   { background: #e94560; }
.bg-green { background: #2ecc71; }
.bg-blue  { background: #3498db; }
.bg-white { background: #fff; }

.card {
  background: #fff;
  border-radius: 10px;
  padding: 14px;
  margin: 10px 14px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  box-sizing: border-box;
}

/* 统一盒模型，避免输入框 padding 把页面撑宽 */
.input,
input,
textarea,
.picker-value,
.btn,
.card {
  box-sizing: border-box;
  max-width: 100%;
}

.tag {
  display: inline-block;
  padding: 3px 8px;
  border-radius: 4px;
  font-size: 12px;
}
.tag-pending   { background: #eee; color: #999; }
.tag-progress  { background: #dbeafe; color: #2563eb; }
.tag-done      { background: #d1fae5; color: #059669; }
.tag-overdue   { background: #fee2e2; color: #dc2626; }
.tag-no-need   { background: transparent; color: #ccc; }
.tag-warn      { background: #fff4e5; color: #b26a00; }

.step-row {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
}
.step-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}
.step-dot.pending   { background: #ddd; }
.step-dot.progress  { background: #3498db; }
.step-dot.done      { background: #2ecc71; }
.step-dot.overdue   { background: #e94560; }
.step-line {
  width: 12px;
  height: 2px;
  background: #ddd;
  flex-shrink: 0;
}
.step-line.done { background: #2ecc71; }

.btn {
  box-sizing: border-box;
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 14px;
  text-align: center;
  border: none;
}
.btn-primary { background: #e94560; color: #fff; }
.btn-outline { background: #fff; color: #e94560; border: 1px solid #e94560; }
.btn-sm { padding: 5px 10px; font-size: 12px; }
.btn-block { width: 100%; }

.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; }
.gap-8 { gap: 8px; }
.gap-4 { gap: 4px; }
.mt-8 { margin-top: 8px; }
.mt-12 { margin-top: 12px; }
.mt-16 { margin-top: 16px; }
.mb-8 { margin-bottom: 8px; }
.text-sm { font-size: 12px; }
.text-xs { font-size: 11px; }
.text-bold { font-weight: bold; }
.text-right { text-align: right; }

/* ===== PC / 宽屏：内容最大 520px 居中 ===== */
.page {
  max-width: 520px;
  margin-left: auto;
  margin-right: auto;
}


/* ===== 字号分级：15 / 14 / 13 ===== */
page { font-size: 15px; color: #222; font-weight: 500; }

/* 需要强调的：金额、数量、剩余天数、产品名、客户 */
