.card { line-height: 1.7; }
page .field { margin-bottom: 16px; }
page .label { margin-bottom: 6px; line-height: 1.5; }
.page .it-spec, .page .p-spec, .page .spec-label, .page .row-sub, .page .sub, .page .tip {
  line-height: 1.7;
}
.input { line-height: 1.5; }

/* ===== iOS 风格基础 ===== */
page { background: #f2f2f7; color: #1c1c1e; font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif; }
.card { background: #ffffff; border-radius: 14px; border: none; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
.input { background: #f2f2f7; border-radius: 10px; border: none; }
.btn { border-radius: 12px; }
.btn-primary { background: #e94560; color: #fff; border: none; }
.filter.on, .period.on { background: #e94560; border-color: #e94560; color: #fff; }

/* 模块间距统一 */
.page { padding-left: 12px; padding-right: 12px; box-sizing: border-box; }
.page > .card, .page > block > .card { margin-left: 0; margin-right: 0; margin-bottom: 10px; }
.page > .card:last-child, .page > block:last-child > .card { margin-bottom: 0; }

/* openid 识别码一行（用户管理页、订单页等待放行提示都用它） */
.oid-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 8px;
}
.oid-text {
  font-size: 14px;
  color: #2b5bb3;
  font-family: monospace;
  flex: 1;
  min-width: 0;
  word-break: break-all;
}
.copy {
  font-size: 14px;
  color: #888;
  flex-shrink: 0;
}
